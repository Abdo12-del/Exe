<Window x:Class="SalesManagement.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل الدخول - تاجر برو (Taajer PRO)"
        Height="550" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Icon="../app_icon.ico"
        Background="{StaticResource BackgroundBrush}">
    <Border Background="{StaticResource CardBackgroundBrush}" Margin="24" CornerRadius="12" Padding="32">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Direction="270" ShadowDepth="4" Opacity="0.1" Color="#000000"/>
        </Border.Effect>

        <StackPanel VerticalAlignment="Center">
            <!-- App Logo / Header -->
            <Border Width="64" Height="64" Background="{StaticResource PrimaryLightBrush}" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="🛒" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="تاجر برو (Taajer PRO)" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryDarkBrush}"/>
            <TextBlock Text="نظام إدارة المبيعات ونقاط البيع المكتبي (Offline)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,24"/>

            <!-- Error Banner -->
            <Border Background="#FEE2E2" BorderBrush="#F87171" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,16"
                    Visibility="{Binding ErrorMessage, Converter={x:Null}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="13" TextWrapping="Wrap"/>
            </Border>

            <!-- Username Field -->
            <TextBlock Text="اسم المستخدم:" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0,0,0,16"/>

            <!-- Password Field -->
            <TextBlock Text="كلمة المرور:" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
            <PasswordBox x:Name="UserPasswordBox" Height="40" Margin="0,0,0,24" PasswordChanged="PasswordBox_PasswordChanged"/>

            <!-- Login Button -->
            <Button Content="تسجيل الدخول" Style="{StaticResource PrimaryButton}" Height="45" FontSize="16" Command="{Binding LoginCommand}"/>

            <!-- Footer note -->
            <TextBlock Text="الافتراضي: admin / admin123" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,20,0,0"/>
        </StackPanel>
    </Border>
</Window>
